{
  "name": "alogi",
  "version": "0.1.18",
  "description": "AI-powered log viewer for local and remote logs",
  "author": "allisonhere <allisonhere@users.noreply.github.com>",
  "homepage": "https://allisonhere.github.io/alogi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/allisonhere/alogi.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "concurrently -k \"next dev\" \"wait-on http://127.0.0.1:3000 && ELECTRON_START_URL=http://127.0.0.1:3000 electron .\"",
    "build": "next build",
    "build:desktop": "next build",
    "start": "next start",
    "lint": "eslint",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage deb --publish never",
    "dist:linux:dir": "npm run build:desktop && electron-builder --linux dir --publish never",
    "dist:linux:all": "npm run build:desktop && electron-builder --linux AppImage deb dir --publish never"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/ssh2": "^1.15.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "electron": "^32.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.allisonhere.alogi",
    "productName": "Alogi",
    "executableName": "alogi",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": ".next/standalone"
      },
      {
        "from": ".next/static",
        "to": ".next/standalone/.next/static"
      }
    ],
    "linux": {
      "artifactName": "Alogi-${arch}.${ext}",
      "maintainer": "allisonhere <allisonhere@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
